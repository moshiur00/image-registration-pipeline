# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Project data and generated results
# Small files in data/samples are intentionally tracked.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# Logs and temporary files
*.log
*.tmp

# Local archives
*.zip
