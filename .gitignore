# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Project data and generated results
# Small files in data/samples are intentionally tracked.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# Logs and temporary files
*.log
*.tmp

# Local archives
*.zip

# Generated real multimodal test handoff package
deliverables/real_multimodal_rire_test/

# Private Week 8 enrollment staging. Only the attachment contract is tracked;
# source pixels, labels, sidecars, and custodian packages must remain ignored.
data/holdout/week08/*
!data/holdout/week08/README.md

# Private R3 Week 8 enrollment staging. Fresh holdout pixels, labels,
# provenance sidecars, and custodian packages must never be tracked.
data/holdout/week08_r3/*
!data/holdout/week08_r3/README.md
